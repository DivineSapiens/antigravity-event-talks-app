# pyenv
#   For a library or app, you might want to share your .python-version.
#   See: https://github.com/pyenv/pyenv/wiki/Authoring-shared-profiles#pyenv-challenge
#.python-version

# pipenv
#   According to Pipfile.lock, it should be placed in version control.
#   However, if you're deploying a library, Pipfile.lock can prevent installation of matching dependencies.
#   So, we'll ignore Pipfile.lock for now.
#Pipfile.lock

# poetry
#   Similarly, poetry.lock should be in version control, but you can ignore it if needed.
#poetry.lock

# pdm
#   Similar to Pipfile.lock, pdm.lock should be in version control.
#pdm.lock
.pdm-plugins/
.pdm-python/

# PEP 582; used by e.g. github.com/lincolnloop/layman and github.com/pdm-project/pdm
__pypackages__/

